end

def runtime_backend_ids(token)
  encoded = token.split(".").fetch(1)
  encoded += "=" * ((4 - encoded.length % 4) % 4)
  payload = JSON.parse(Base64.urlsafe_decode64(encoded))
  scope = payload.fetch("scp").split.find { |item| item.start_with?("Actions.Results:") }
  _prefix, run_backend_id, job_backend_id = scope.split(":", 3)
  [run_backend_id, job_backend_id]
rescue StandardError
  [nil, nil]
end

def artifact_twirp(method, body, token, base_url)
  return { "status" => 0, "endpoint_present" => false, "parsed" => {} } if base_url.empty?

  uri = URI.join(base_url, "/twirp/github.actions.results.api.v1.ArtifactService/#{method}")
  request = Net::HTTP::Post.new(uri)
  request["Authorization"] = "Bearer #{token}"
  request["Content-Type"] = "application/json"
  request["User-Agent"] = "@actions/artifact-owned-boundary-control"
  request.body = JSON.generate(body)
  response = http_request(uri, request)
  parsed = JSON.parse(response["body"])
  response.merge("endpoint_present" => true, "parsed" => parsed)
rescue JSON::ParserError
  response.merge("endpoint_present" => true, "parsed" => {})
rescue StandardError => error
  {
    "status" => 0,
    "endpoint_present" => true,
    "parsed" => {},
    "error_class" => error.class.name
  }
end

