def download_owned_zip(url, expected_canary)
  return { "downloaded" => false, "canary_match" => false } if url.to_s.empty?

  uri = URI(url)
  redirects = 0
  loop do
    request = Net::HTTP::Get.new(uri)
    response = http_request(uri, request, body_limit: 1_048_576)
    if [301, 302, 303, 307, 308].include?(response["status"]) && redirects < 3
      location = response["location"]
      return { "downloaded" => false, "canary_match" => false, "status" => response["status"] } unless location
      uri = URI.join(uri, location)
      redirects += 1
      next
    end

    return {
      "downloaded" => false,
      "canary_match" => false,
      "status" => response["status"],
      "request_id" => response["request_id"]
    } unless response["status"] == 200

    python = <<~'PYTHON'
      import base64
      import io
      import os
      import sys
      import zipfile

      expected = base64.b64decode(os.environ["EXPECTED_CANARY_B64"])
      matched = False
      with zipfile.ZipFile(io.BytesIO(sys.stdin.buffer.read())) as archive:
          for name in archive.namelist():
              if name.endswith("private-artifact-canary.txt"):
                  matched = archive.read(name) == expected
      print("1" if matched else "0")
    PYTHON
    stdout, _stderr, process = Open3.capture3(
      { "EXPECTED_CANARY_B64" => Base64.strict_encode64(expected_canary) },
      "python3",
      "-c",
      python,
      stdin_data: response["body"]
    )
    return {
      "downloaded" => true,
      "canary_match" => process.success? && stdout.strip == "1",
      "status" => response["status"],
      "request_id" => response["request_id"],
      "zip_parse_success" => process.success?
    }
  end
rescue StandardError => error
  {
    "downloaded" => false,
    "canary_match" => false,
    "error_class" => error.class.name
  }
end

