def http_request(uri, request, body_limit: 131_072)
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 5, read_timeout: 15) do |http|
    http.request(request)
  end
  body = response.body.to_s
  body = "" if body.bytesize > body_limit
  {
    "status" => response.code.to_i,
    "request_id" => response["x-github-request-id"] || response["x-vss-e2eid"] || response["x-ms-request-id"],
    "location" => response["location"],
    "body" => body
  }
rescue StandardError => error
  {
    "status" => 0,
    "request_id" => nil,
    "error_class" => error.class.name,
    "body" => ""
  }
end

def github_get(path, token)
  uri = URI("#{API}#{path}")
  request = Net::HTTP::Get.new(uri)
  request["Accept"] = "application/vnd.github+json"
  request["Authorization"] = "Bearer #{token}" unless token.empty?
  request["User-Agent"] = "gh-r49-owned-escalation-control"
  request["X-GitHub-Api-Version"] = "2022-11-28"
  http_request(uri, request)
end

def cache_v1_get(key, version, token, base_url)
  return { "status" => 0, "endpoint_present" => false } if base_url.empty?

  query = URI.encode_www_form("keys" => key, "version" => version)
  uri = URI("#{base_url}_apis/artifactcache/cache?#{query}")
  request = Net::HTTP::Get.new(uri)
  request["Accept"] = "application/json;api-version=6.0-preview.1"
  request["Authorization"] = "Bearer #{token}"
  request["User-Agent"] = "@actions/cache-owned-boundary-control"
  response = http_request(uri, request)

  parsed = JSON.parse(response["body"])
  response.merge(
    "endpoint_present" => true,
    "matched_key" => parsed["cacheKey"],
    "download_url" => parsed["archiveLocation"]
  )
rescue JSON::ParserError
  response.merge("endpoint_present" => true, "matched_key" => nil, "download_url" => nil)
rescue StandardError => error
  {
    "status" => 0,
    "endpoint_present" => true,
    "error_class" => error.class.name,
    "download_url" => nil
  }
end

def cache_v2_get(key, version, token, base_url)
  return { "status" => 0, "endpoint_present" => false } if base_url.empty?

  uri = URI.join(base_url, "/twirp/github.actions.results.api.v1.CacheService/GetCacheEntryDownloadURL")
  request = Net::HTTP::Post.new(uri)
  request["Authorization"] = "Bearer #{token}"
  request["Content-Type"] = "application/json"
  request["User-Agent"] = "@actions/cache-owned-boundary-control"
  request.body = JSON.generate("key" => key, "restore_keys" => [], "version" => version)
  response = http_request(uri, request)

  parsed = JSON.parse(response["body"])
  response.merge(
    "endpoint_present" => true,
    "ok" => parsed["ok"] == true,
    "matched_key" => parsed["matched_key"],
    "download_url" => parsed["signed_download_url"]
  )
rescue JSON::ParserError
  response.merge("endpoint_present" => true, "ok" => false, "matched_key" => nil, "download_url" => nil)
rescue StandardError => error
  {
    "status" => 0,
    "endpoint_present" => true,
    "error_class" => error.class.name,
    "download_url" => nil
  }
end

def download_owned_cache(url, expected_canary)
  return { "downloaded" => false, "canary_match" => false } if url.to_s.empty?

  uri = URI(url)
  redirects = 0
  loop do
    request = Net::HTTP::Get.new(uri)
    response = http_request(uri, request, body_limit: 1_048_576)
    if [301, 302, 303, 307, 308].include?(response["status"]) && redirects < 3
      location = response["location"]
      return { "downloaded" => false, "canary_match" => false, "status" => response["status"] } unless location
      uri = URI.join(uri, location)
      redirects += 1
      next
    end

    return {
      "downloaded" => false,
      "canary_match" => false,
      "status" => response["status"],
      "request_id" => response["request_id"]
    } unless response["status"] == 200

    archive = response["body"]
    tar_bytes = archive
    compression = "plain"
    if archive.byteslice(0, 4)&.bytes == [0x28, 0xb5, 0x2f, 0xfd]
      tar_bytes, stderr, process = Open3.capture3("zstd", "-d", "-c", stdin_data: archive)
      return {
        "downloaded" => true,
        "canary_match" => false,
        "status" => response["status"],
        "decompression" => "zstd_failed"
      } unless process.success? && stderr.to_s.bytesize < 4096
      compression = "zstd"
    end

    canary_match = false
    Gem::Package::TarReader.new(StringIO.new(tar_bytes)) do |tar|
      tar.each do |entry|
        next unless entry.file? && entry.full_name.end_with?("r56-cache/private-canary.txt")
        canary_match = entry.read == expected_canary
      end
    end

    return {
      "downloaded" => true,
      "canary_match" => canary_match,
      "status" => response["status"],
      "request_id" => response["request_id"],
      "compression" => compression
    }
  end
rescue StandardError => error
  {
    "downloaded" => false,
    "canary_match" => false,
    "error_class" => error.class.name
  }
end

def sanitized_cache_result(response, expected_canary)
  download = download_owned_cache(response["download_url"], expected_canary)
  {
    "endpoint_present" => response["endpoint_present"],
    "status" => response["status"],
    "request_id" => response["request_id"],
    "ok" => response["ok"],
    "matched_key" => response["matched_key"],
    "signed_download_url_present" => !response["download_url"].to_s.empty?,
    "download" => download,
    "error_class" => response["error_class"]
  }
end

