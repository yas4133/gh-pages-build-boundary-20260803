def endpoint_status(uri_string, method: :get, headers: {})
  uri = URI(uri_string)
  request = method == :put ? Net::HTTP::Put.new(uri) : Net::HTTP::Get.new(uri)
  headers.each { |key, value| request[key] = value }
  response = http_request(uri, request, body_limit: 65_536)
  {
    "status" => response["status"],
    "request_id" => response["request_id"],
    "response_body_present" => !response["body"].to_s.empty?,
    "error_class" => response["error_class"]
  }
end

def sandbox_boundary_probe
  docker_inventory = {
    "socket_present" => File.socket?("/var/run/docker.sock"),
    "api_reachable" => false,
    "api_version" => nil,
    "container_count" => nil,
    "error_class" => nil
  }
  if docker_inventory["socket_present"]
    begin
      docker_get = lambda do |path|
        stdout, _stderr, process = Open3.capture3(
          "curl",
          "--silent",
          "--show-error",
          "--max-time",
          "5",
          "--unix-socket",
          "/var/run/docker.sock",
          "http://localhost#{path}"
        )
        raise "docker_api_request_failed" unless process.success?
        [200, JSON.parse(stdout)]
      end
      version_status, version = docker_get.call("/version")
      containers_status, containers = docker_get.call("/containers/json?all=1")
      docker_inventory["api_reachable"] = version_status == 200 && containers_status == 200
      docker_inventory["api_version"] = version["ApiVersion"]
      docker_inventory["container_count"] = containers.length if containers.is_a?(Array)
    rescue StandardError => error
      docker_inventory["error_class"] = error.class.name
    end
  end

  {
    "host_control_sockets" => {
      "docker_socket_present" => File.socket?("/var/run/docker.sock"),
      "containerd_socket_present" => File.socket?("/run/containerd/containerd.sock") || File.socket?("/var/run/containerd/containerd.sock"),
      "kubernetes_service_account_token_present" => File.file?("/var/run/secrets/kubernetes.io/serviceaccount/token"),
      "kvm_device_present" => File.exist?("/dev/kvm")
    },
    "docker_read_only_inventory" => docker_inventory,
    "cloud_metadata_status_only" => {
      "aws_imdsv2_token" => endpoint_status(
        "http://169.254.169.254/latest/api/token",
        method: :put,
        headers: { "X-aws-ec2-metadata-token-ttl-seconds" => "60" }
      ),
      "azure_instance_metadata" => endpoint_status(
        "http://169.254.169.254/metadata/instance?api-version=2021-02-01",
        headers: { "Metadata" => "true" }
      ),
      "azure_managed_identity_token" => endpoint_status(
        "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fmanagement.azure.com%2F",
        headers: { "Metadata" => "true" }
      ),
      "gcp_default_service_account_token" => endpoint_status(
        "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token",
        headers: { "Metadata-Flavor" => "Google" }
      )
    }
  }
end

