def oidc_claim_probe(request_url, request_token)
  return { "endpoint_present" => false } if request_url.empty? || request_token.empty?

  uri = URI(request_url)
  params = URI.decode_www_form(uri.query.to_s).reject { |key, _value| key == "audience" }
  params << ["audience", "gh-r49-owned-boundary-control"]
  uri.query = URI.encode_www_form(params)
  request = Net::HTTP::Get.new(uri)
  request["Authorization"] = "Bearer #{request_token}"
  request["User-Agent"] = "gh-r49-owned-oidc-control"
  response = http_request(uri, request)
  encoded_token = JSON.parse(response["body"])["value"]

  claims = {}
  unless encoded_token.to_s.empty?
    encoded = encoded_token.split(".").fetch(1)
    encoded += "=" * ((4 - encoded.length % 4) % 4)
    decoded = JSON.parse(Base64.urlsafe_decode64(encoded))
    %w[iss aud sub repository repository_owner actor ref job_workflow_ref environment].each do |key|
      claims[key] = decoded[key] if decoded.key?(key)
    end
  end

  {
    "endpoint_present" => true,
    "status" => response["status"],
    "request_id" => response["request_id"],
    "token_returned" => !encoded_token.to_s.empty?,
    "selected_claims" => claims
  }
rescue StandardError => error
  {
    "endpoint_present" => true,
    "status" => response ? response["status"] : 0,
    "request_id" => response ? response["request_id"] : nil,
    "token_returned" => false,
    "error_class" => error.class.name
  }
end

